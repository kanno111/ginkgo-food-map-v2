DB_URL=jdbc:mysql://localhost:3306/ginkgo_food_map?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace_with_local_mysql_password
DB_POOL_SIZE=10

MYSQL_DATABASE=ginkgo_food_map
MYSQL_USER=ginkgo
MYSQL_PASSWORD=replace_with_mysql_app_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=4

# SMTP 示例只声明变量格式，真实账号和密码保存在未纳入版本控制的本地环境中。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
AUTH_MAIL_FROM=no-reply@example.com

# 多个允许域名使用逗号分隔；HMAC 密钥应使用密码学安全随机值且至少 32 个字符。
AUTH_ALLOWED_EMAIL_DOMAINS=std.uestc.edu.cn
AUTH_CODE_HMAC_SECRET=replace_with_at_least_32_random_characters

# RSA 密钥文件放在仓库外部或被忽略的 secrets 目录，私钥不得提交到 Git。
JWT_ISSUER=ginkgo-food-map
JWT_AUDIENCE=ginkgo-food-map-api
JWT_TTL=7d
JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem
JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem

SERVER_PORT=8080

BACKEND_HOST=host.docker.internal
BACKEND_PORT=8080
