.privacy-page {
  padding-top: 36rpx;
}

.privacy-head {
  padding: 8rpx 12rpx 26rpx;
}

.privacy-title {
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.privacy-desc {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.7;
}

.privacy-card {
  padding: 6rpx 28rpx;
}

.privacy-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
}

.privacy-row-copy {
  flex: 1;
  padding-right: 20rpx;
}

.privacy-row-label {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 500;
}

.privacy-row-sub {
  margin-top: 8rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.privacy-switch {
  flex-shrink: 0;
  transform: scale(0.86);
  transform-origin: right center;
}

.privacy-divider {
  height: 1rpx;
  background: rgba(9, 60, 110, 0.08);
}

.privacy-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 20rpx 26rpx;
  border: 1rpx solid rgba(184, 58, 52, 0.24);
  border-radius: 24rpx;
  background: rgba(255, 240, 238, 0.72);
}

.privacy-error-text {
  flex: 1;
  color: var(--danger);
  font-size: 23rpx;
  line-height: 1.6;
}

.privacy-error-action {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: var(--accent-deep);
  font-size: 23rpx;
}

.privacy-status {
  margin-top: 22rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  text-align: center;
}

.privacy-login {
  padding: 32rpx 28rpx;
}

.privacy-login-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.privacy-login-text {
  margin: 12rpx 0 26rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.7;
}

.privacy-note {
  margin-top: 28rpx;
  padding: 0 14rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  line-height: 1.8;
}
