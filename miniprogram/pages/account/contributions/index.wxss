@import "../content/index.wxss";

.contribution-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.filter-chip {
  display: flex;
  align-items: center;
  margin: 6rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  background: var(--glass-soft);
  color: var(--ink-soft);
  font-size: 23rpx;
}

.filter-chip.active {
  border-color: rgba(10, 132, 255, 0.4);
  background: rgba(10, 132, 255, 0.12);
  color: var(--accent-deep);
  font-weight: 600;
}

.filter-count {
  margin-left: 8rpx;
  color: var(--ink-muted);
  font-size: 20rpx;
}

.filter-chip.active .filter-count {
  color: var(--accent-deep);
}

.contribution-card {
  margin-top: 18rpx;
}

.contribution-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contribution-name {
  flex: 1;
  overflow: hidden;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contribution-name.title-muted {
  color: var(--ink-muted);
}

.status-badge {
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.status-pending {
  background: rgba(198, 134, 11, 0.14);
  color: var(--gold);
}

.status-approved {
  background: rgba(31, 157, 97, 0.14);
  color: var(--mint);
}

.status-rejected {
  background: rgba(184, 58, 52, 0.12);
  color: var(--danger);
}

.status-withdrawn {
  background: rgba(111, 130, 148, 0.14);
  color: var(--ink-muted);
}

.contribution-meta {
  margin-top: 10rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.contribution-note {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.65;
}

.contribution-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.62);
}

.contribution-id {
  color: var(--ink-muted);
  font-size: 21rpx;
}
