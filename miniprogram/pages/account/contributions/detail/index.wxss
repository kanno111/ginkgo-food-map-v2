@import "../index.wxss";

.detail-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.detail-head {
  margin-top: 8rpx;
}

.detail-head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-name {
  flex: 1;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
  word-break: break-word;
}

.detail-meta {
  margin-top: 10rpx;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.detail-timeline {
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 1.7;
}

.section-title {
  margin-bottom: 8rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
}

.reject-card {
  border-color: rgba(184, 58, 52, 0.24);
  background: rgba(255, 244, 243, 0.72);
}

.reject-text {
  margin-top: 8rpx;
  color: var(--danger);
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-word;
}

.field-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.56);
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.field-value {
  flex: 1;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-word;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 10rpx -8rpx 0;
}

.photo-cell {
  position: relative;
  width: calc(33.33% - 16rpx);
  height: 200rpx;
  margin: 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.4);
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-state {
  display: flex;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
  color: var(--ink-muted);
  font-size: 20rpx;
  text-align: center;
}

.photo-error {
  color: var(--danger);
}

.photo-retry {
  margin-top: 10rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--accent-deep);
  font-size: 21rpx;
}

.detail-action {
  margin-top: 22rpx;
}

.readonly-note {
  margin-top: 22rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}

.action-card {
  margin-top: 22rpx;
}

.action-copy {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.7;
  word-break: break-word;
}

.field-hint {
  margin-top: 12rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.action-button {
  margin: 0 16rpx 0 0;
  padding: 0 34rpx;
}

.action-danger {
  border-color: rgba(184, 58, 52, 0.35);
  color: var(--danger);
}

.is-disabled {
  opacity: 0.55;
}

.action-error {
  margin-top: 16rpx;
}
