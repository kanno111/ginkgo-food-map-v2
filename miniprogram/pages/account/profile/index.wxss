@import "../content/index.wxss";

.profile-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.profile-card {
  margin-top: 8rpx;
}

.profile-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.56);
}

.profile-label {
  flex-shrink: 0;
  color: var(--ink-muted);
  font-size: 24rpx;
}

.profile-value {
  flex: 1;
  margin-left: 24rpx;
  color: var(--ink);
  font-size: 25rpx;
  text-align: right;
  word-break: break-all;
}

.profile-note {
  margin-top: 12rpx;
  color: var(--ink-muted);
  font-size: 21rpx;
  line-height: 1.7;
}

.bio-card {
  margin-top: 18rpx;
}

.bio-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
}

.bio-count {
  color: var(--ink-muted);
  font-size: 21rpx;
}

.bio-count-error {
  color: var(--danger);
}

.bio-input {
  width: 100%;
  min-height: 200rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--glass-line);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: inset 0 2rpx 8rpx rgba(9, 48, 86, 0.06);
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.7;
}

.field-error {
  margin-top: 10rpx;
  color: var(--danger);
  font-size: 22rpx;
  line-height: 1.6;
}

.bio-actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.bio-clear {
  margin-right: 16rpx;
  padding: 0 26rpx;
  color: var(--danger);
}

.bio-save {
  flex: 1;
}

.bio-save.disabled {
  opacity: 0.5;
}
