.content-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.content-head {
  margin-bottom: 24rpx;
}

.content-title {
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.content-sub {
  margin-top: 8rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
}

.segmented {
  display: flex;
  padding: 8rpx;
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  background: var(--glass);
  box-shadow: var(--glass-inset);
  backdrop-filter: blur(18px) saturate(160%);
}

.segment {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 999rpx;
  color: var(--ink-muted);
  font-size: 26rpx;
  text-align: center;
}

.segment.active {
  background: linear-gradient(135deg, rgba(55, 169, 255, 0.94), rgba(10, 132, 255, 0.94));
  box-shadow: 0 10rpx 24rpx rgba(10, 132, 255, 0.24);
  color: #ffffff;
  font-weight: 600;
}

.content-meta {
  min-height: 40rpx;
  margin: 18rpx 6rpx 12rpx;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.content-hint {
  margin: 0 6rpx 16rpx;
}

.content-state {
  margin-top: 18rpx;
  text-align: center;
}

.state-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.state-copy {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.7;
}

.state-action {
  width: 300rpx;
  margin: 24rpx auto 0;
}

.content-card {
  margin-top: 18rpx;
}

.content-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.content-card-title {
  flex: 1;
  overflow: hidden;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-card-title.title-closed {
  color: var(--ink-muted);
  text-decoration: line-through;
}

.content-score {
  margin-left: 18rpx;
  color: var(--gold);
  font-size: 34rpx;
  font-weight: 700;
}

.content-card-meta {
  margin-top: 8rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.content-card-body {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.content-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.62);
}

.content-badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.badge {
  margin-right: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.badge-good {
  background: rgba(31, 157, 97, 0.14);
  color: var(--mint);
}

.badge-plain {
  background: rgba(255, 255, 255, 0.52);
  color: var(--ink-muted);
}

.content-link {
  color: var(--accent-deep);
  font-size: 23rpx;
}

.favorite-card {
  padding-top: 26rpx;
  padding-bottom: 22rpx;
}

.favorite-row {
  display: flex;
  align-items: center;
}

.favorite-copy {
  flex: 1;
  min-width: 0;
}

.favorite-remove {
  margin-left: 18rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(184, 58, 52, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  color: var(--danger);
  font-size: 22rpx;
}

.favorite-card .content-card-foot {
  margin-top: 12rpx;
}

.load-more {
  margin-top: 20rpx;
  padding: 20rpx 0;
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  background: var(--glass-soft);
  color: var(--accent-deep);
  font-size: 24rpx;
  text-align: center;
}
