.home-page {
  padding-top: 20rpx;
}

.home-head {
  padding: 12rpx 4rpx 24rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.brand-mark {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(178, 222, 255, 0.55));
  box-shadow: 0 12rpx 28rpx rgba(27, 63, 104, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  color: #0a6fbf;
  font-size: 38rpx;
  font-weight: 800;
}

.brand-name {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.brand-sub {
  margin-top: 2rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.login-chip {
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  background: linear-gradient(135deg, #37a9ff, #0a84ff 55%, #0066cc);
  box-shadow: 0 10rpx 24rpx rgba(10, 132, 255, 0.28);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
}

.search-box {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 10rpx 0 30rpx;
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  background: var(--glass-strong);
  box-shadow: 0 18rpx 44rpx rgba(27, 63, 104, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(16px) saturate(170%);
  -webkit-backdrop-filter: blur(16px) saturate(170%);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.search-placeholder {
  color: #91a3b4;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-muted);
  font-size: 34rpx;
}

.search-action {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(10, 132, 255, 0.12);
  color: var(--accent-deep);
  font-size: 25rpx;
  font-weight: 750;
}

.category-scroll {
  white-space: nowrap;
  margin: 4rpx 0 18rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  height: 66rpx;
  margin-right: 14rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  background: var(--glass-soft);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  color: var(--ink-soft);
  font-size: 25rpx;
  backdrop-filter: blur(10px) saturate(150%);
  -webkit-backdrop-filter: blur(10px) saturate(150%);
}

.category-chip.active {
  border-color: rgba(255, 255, 255, 0.45);
  background: linear-gradient(135deg, #37a9ff, #0a84ff 58%, #0066cc);
  box-shadow: 0 10rpx 24rpx rgba(10, 132, 255, 0.25), inset 0 1rpx 0 rgba(255, 255, 255, 0.45);
  color: #ffffff;
  font-weight: 700;
}

.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.28);
}

.result-count {
  color: var(--ink-muted);
  font-size: 24rpx;
}

.result-actions {
  display: flex;
  align-items: center;
}

.add-shop {
  margin-right: 18rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(10, 132, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  color: var(--accent-deep);
  font-size: 23rpx;
  font-weight: 650;
}

.sort-picker {
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 650;
}

.restaurant-list {
  padding-top: 2rpx;
}

.restaurant-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 22rpx;
  border: 1rpx solid var(--glass-line);
  border-radius: 34rpx;
  background: var(--glass);
  box-shadow: var(--glass-shadow), var(--glass-inset);
  backdrop-filter: blur(16px) saturate(165%);
  -webkit-backdrop-filter: blur(16px) saturate(165%);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.restaurant-cover {
  position: relative;
  flex: 0 0 196rpx;
  width: 196rpx;
  height: 176rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(210, 226, 240, 0.7);
}

.cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.closed-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 10rpx;
  background: rgba(184, 58, 52, 0.82);
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
}

.restaurant-copy {
  flex: 1;
  min-width: 0;
}

.restaurant-name {
  margin-bottom: 10rpx;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.rating-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.score {
  margin-right: 14rpx;
  color: #c4680a;
  font-size: 38rpx;
  font-weight: 800;
}

.rating-note {
  margin-right: 14rpx;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.price {
  margin-left: auto;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.meta-line {
  margin-bottom: 6rpx;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.category {
  color: #166a7a;
  font-weight: 700;
}

.meta-dot {
  margin: 0 8rpx;
  color: #a7b6c5;
}

.address-line {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.recommend-line {
  margin-top: 4rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.retry-button {
  width: 240rpx;
  margin: 28rpx auto 0;
}

.load-more {
  padding: 30rpx 0 10rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
  text-align: center;
}

.home-footer {
  padding: 48rpx 0 12rpx;
  color: #8ea0b1;
  font-size: 22rpx;
  text-align: center;
}
