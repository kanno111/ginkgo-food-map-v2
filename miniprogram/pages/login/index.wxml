<view class="page login-page">
  <view class="ambient">
    <view class="ambient-blob ambient-a"></view>
    <view class="ambient-blob ambient-b"></view>
    <view class="ambient-blob ambient-c"></view>
  </view>

  <view class="login-hero">
    <view class="login-mark">G</view>
    <view class="login-title">邮箱登录</view>
    <view class="login-subtitle">使用注册邮箱继续，不获取微信账号信息</view>
  </view>

  <view class="card login-card">
    <view class="field">
      <view class="field-label">注册邮箱</view>
      <view class="field-shell">
        <input
          class="field-input"
          type="text"
          confirm-type="next"
          placeholder="name@std.uestc.edu.cn"
          placeholder-class="field-placeholder"
          maxlength="254"
          value="{{email}}"
          bindinput="onEmailInput"
        />
      </view>
    </view>

    <view class="field">
      <view class="field-label">密码</view>
      <view class="field-shell">
        <input
          class="field-input"
          type="text"
          password
          confirm-type="done"
          placeholder="请输入密码"
          placeholder-class="field-placeholder"
          maxlength="72"
          value="{{password}}"
          bindinput="onPasswordInput"
          bindconfirm="submit"
        />
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="error-text login-error">{{errorMessage}}</view>

    <button
      class="primary-button login-button"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submit"
    >
      {{submitting ? '登录中…' : '登录'}}
    </button>
  </view>

  <view class="login-links">
    <text class="login-link" bindtap="openRegister">注册账号</text>
    <text class="login-link-sep">·</text>
    <text class="login-link" bindtap="openPasswordReset">忘记密码</text>
  </view>

  <view class="login-note">
    登录仅使用注册邮箱与密码；小程序不会获取微信头像、昵称、手机号或 openid。
  </view>
</view>
