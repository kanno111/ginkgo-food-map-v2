.login-page {
  min-height: 100vh;
  padding: 64rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
}

.login-hero {
  padding: 24rpx 12rpx 52rpx;
}

.login-mark {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 40rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.8), rgba(163, 216, 255, 0.55));
  box-shadow: 0 24rpx 54rpx rgba(27, 63, 104, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  color: #0a6fbf;
  font-size: 60rpx;
  font-weight: 800;
}

.login-title {
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.login-subtitle {
  margin-top: 12rpx;
  color: var(--ink-muted);
  font-size: 25rpx;
}

.login-card {
  padding: 36rpx 30rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 650;
}

.login-error {
  margin: 4rpx 4rpx 20rpx;
}

.login-button {
  width: 100%;
  margin-top: 8rpx;
}

.login-note {
  margin-top: 30rpx;
  padding: 0 18rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  line-height: 1.8;
  text-align: center;
}

.login-links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
}

.login-link {
  color: var(--accent-deep);
  font-size: 24rpx;
}

.login-link-sep {
  margin: 0 18rpx;
  color: var(--ink-muted);
  font-size: 20rpx;
}
