<view class="page login-page">
  <view class="ambient">
    <view class="ambient-blob ambient-a"></view>
    <view class="ambient-blob ambient-b"></view>
    <view class="ambient-blob ambient-c"></view>
  </view>

  <view class="login-hero">
    <view class="login-mark">G</view>
    <view class="login-title">注册账号</view>
    <view class="login-subtitle">使用学校学生邮箱接收验证码</view>
  </view>

  <view class="card login-card">
    <view class="field">
      <view class="field-label">学校邮箱</view>
      <view class="field-shell">
        <input
          class="field-input"
          type="text"
          confirm-type="next"
          placeholder="name@std.uestc.edu.cn"
          placeholder-class="field-placeholder"
          maxlength="254"
          value="{{email}}"
          bindinput="onEmailInput"
        />
      </view>
      <view class="field-hint">需使用学校学生邮箱 @std.uestc.edu.cn</view>
    </view>

    <view class="field">
      <view class="field-label">邮箱验证码</view>
      <view class="code-row">
        <view class="field-shell code-input">
          <input
            class="field-input"
            type="number"
            confirm-type="next"
            placeholder="6 位数字"
            placeholder-class="field-placeholder"
            maxlength="6"
            value="{{verificationCode}}"
            bindinput="onCodeInput"
          />
        </view>
        <view
          class="ghost-button code-button {{sendingCode || countdown > 0 ? 'code-button-disabled' : ''}}"
          bindtap="sendCode"
        >
          {{sendingCode ? '发送中…' : countdown > 0 ? countdown + 's 后重发' : '获取验证码'}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">用户名</view>
      <view class="field-shell">
        <input
          class="field-input"
          type="text"
          confirm-type="next"
          placeholder="2–24 个字符"
          placeholder-class="field-placeholder"
          maxlength="24"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>
      <view class="field-hint">可使用中文、英文字母、数字和下划线，注册后不可改名。</view>
    </view>

    <view class="field">
      <view class="field-label">密码</view>
      <view class="field-shell">
        <input
          class="field-input"
          type="text"
          password
          confirm-type="next"
          placeholder="4–32 位英文、数字或符号"
          placeholder-class="field-placeholder"
          maxlength="32"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </view>

    <view class="field">
      <view class="field-label">确认密码</view>
      <view class="field-shell">
        <input
          class="field-input"
          type="text"
          password
          confirm-type="done"
          placeholder="再次输入密码"
          placeholder-class="field-placeholder"
          maxlength="32"
          value="{{confirmPassword}}"
          bindinput="onConfirmInput"
          bindconfirm="submit"
        />
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="error-text login-error">{{errorMessage}}</view>

    <button
      class="primary-button login-button"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submit"
    >
      {{submitting ? '注册中…' : '注册并登录'}}
    </button>
  </view>

  <view class="login-note">
    注册即表示同意使用校园邮箱作为账号标识；小程序不会获取微信头像、昵称、手机号或 openid。
  </view>
</view>
