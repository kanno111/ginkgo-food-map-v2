.messages-hero {
  padding: 40rpx 8rpx 28rpx;
}

.hero-eyebrow {
  color: #0a6fbf;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.hero-copy {
  margin-top: 10rpx;
  color: var(--ink-muted);
  font-size: 25rpx;
  line-height: 1.8;
}

.login-card {
  margin-top: 8rpx;
}

.login-title {
  font-size: 30rpx;
  font-weight: 750;
}

.login-copy {
  margin: 10rpx 0 26rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

/* 顶部工具条只显示服务端返回的当前分类未读数。 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
}

.toolbar-count {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.toolbar-label {
  margin-left: 8rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
}

.mark-all {
  min-height: 68rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
}

.is-disabled {
  opacity: 0.45;
}

.category-strip {
  width: 100%;
  margin: 22rpx 0 4rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 14rpx;
  padding: 14rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 650;
}

.category-chip.active {
  border-color: rgba(10, 132, 255, 0.4);
  background: linear-gradient(135deg, rgba(55, 169, 255, 0.95), rgba(0, 102, 204, 0.95));
  box-shadow: 0 12rpx 28rpx rgba(10, 132, 255, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  color: #ffffff;
}

.chip-badge {
  min-width: 30rpx;
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #0a6fbf;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}

/* 系统会话卡只展示最新系统摘要，点击进入 SYSTEM 分类，不直接打开正文。 */
.session-card {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
}

.session-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-right: 20rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, rgba(88, 184, 255, 0.85), rgba(0, 102, 204, 0.9));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 750;
}

.session-title {
  font-size: 28rpx;
  font-weight: 750;
}

.session-summary {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--ink-muted);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-dot {
  width: 14rpx;
  height: 14rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: #ff5a4f;
  box-shadow: 0 0 0 6rpx rgba(255, 90, 79, 0.16);
}

.session-arrow {
  margin-left: 12rpx;
  color: var(--ink-muted);
  font-size: 32rpx;
  line-height: 1;
}

.notice-text {
  margin: 18rpx 8rpx 0;
  color: var(--mint);
  font-size: 24rpx;
}

.error-card {
  margin-top: 18rpx;
}

.retry-button {
  margin-top: 20rpx;
}

.empty-state {
  margin-top: 18rpx;
}

.empty-title {
  color: var(--ink-soft);
  font-size: 28rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.message-card {
  margin-top: 18rpx;
  padding: 26rpx 28rpx 0;
}

/* 未读消息用内阴影标出左侧强调线，避免改变圆角与布局。 */
.message-card.unread {
  border-color: rgba(10, 132, 255, 0.32);
  box-shadow: 0 22rpx 64rpx rgba(27, 63, 104, 0.14), inset 5rpx 0 0 rgba(10, 132, 255, 0.68),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.message-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.message-headline {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 720;
  line-height: 1.5;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: #ff5a4f;
  box-shadow: 0 0 0 6rpx rgba(255, 90, 79, 0.16);
}

.message-summary {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-all;
}

.message-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.message-time {
  color: var(--ink-muted);
  font-size: 22rpx;
}

.message-hint {
  color: var(--accent-deep);
  font-size: 23rpx;
  font-weight: 650;
}

.message-delete {
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(8, 25, 43, 0.08);
  color: var(--ink-muted);
  font-size: 23rpx;
  text-align: right;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 20rpx 26rpx;
}

.pager-button {
  padding: 12rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  background: var(--glass-soft);
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 650;
}

.pager-status {
  color: var(--ink-muted);
  font-size: 24rpx;
}

/* 详情以底部玻璃面板展示，层级高于悬浮 TabBar。 */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 940;
  background: rgba(8, 25, 43, 0.32);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.sheet {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 950;
  display: flex;
  flex-direction: column;
  max-height: 76vh;
  padding: 30rpx 30rpx 26rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 32rpx 80rpx rgba(27, 63, 104, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-title {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 780;
  line-height: 1.5;
}

.sheet-close {
  margin-left: 20rpx;
  color: var(--accent-deep);
  font-size: 25rpx;
  font-weight: 650;
}

.sheet-meta {
  margin-top: 6rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.sheet-body {
  flex: 1;
  max-height: 52vh;
  margin-top: 20rpx;
}

.sheet-loading {
  padding: 40rpx 0;
  color: var(--ink-muted);
  font-size: 25rpx;
  text-align: center;
}

.detail-block {
  margin-bottom: 22rpx;
}

.detail-label {
  margin-bottom: 8rpx;
  color: var(--ink-muted);
  font-size: 23rpx;
  font-weight: 650;
}

.detail-text {
  display: block;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}

.sheet-action {
  margin-top: 20rpx;
}
