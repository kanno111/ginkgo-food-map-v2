.follows-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.follows-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 10rpx 6rpx 20rpx;
}

.follows-title {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.follows-total {
  color: var(--ink-muted);
  font-size: 23rpx;
}

.list-hint {
  margin: 0 6rpx 16rpx;
}

.state-card {
  margin-top: 18rpx;
  text-align: center;
}

.state-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.state-copy {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.7;
}

.state-action {
  width: 300rpx;
  margin: 24rpx auto 0;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.member-main {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.member-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 50%;
  background: linear-gradient(150deg, rgba(55, 169, 255, 0.3), rgba(10, 132, 255, 0.14));
  color: var(--accent-deep);
  font-size: 32rpx;
  font-weight: 700;
}

.member-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.member-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-level {
  margin-top: 6rpx;
  color: var(--gold);
  font-size: 21rpx;
}

.member-action {
  flex: none;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid rgba(184, 58, 52, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  color: var(--danger);
  font-size: 22rpx;
}

.member-state {
  flex: none;
  margin-left: 16rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.is-disabled {
  opacity: 0.55;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.pager-button {
  padding: 14rpx 30rpx;
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  background: var(--glass-soft);
  color: var(--accent-deep);
  font-size: 23rpx;
}

.pager-text {
  margin: 0 24rpx;
  color: var(--ink-muted);
  font-size: 23rpx;
}
