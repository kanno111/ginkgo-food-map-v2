.profile-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.state-card {
  margin-top: 18rpx;
  text-align: center;
}

.state-card.compact {
  padding-top: 34rpx;
  padding-bottom: 34rpx;
}

.state-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.state-copy {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.7;
  word-break: break-word;
}

.state-action {
  width: 300rpx;
  margin: 24rpx auto 0;
}

.profile-card {
  margin-top: 8rpx;
}

.profile-identity {
  display: flex;
  align-items: center;
}

.profile-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 50%;
  background: linear-gradient(150deg, rgba(55, 169, 255, 0.32), rgba(10, 132, 255, 0.16));
  color: var(--accent-deep);
  font-size: 44rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 30rpx rgba(10, 132, 255, 0.16);
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.profile-heading {
  display: flex;
  align-items: center;
}

.profile-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-badge {
  flex: none;
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(214, 158, 46, 0.16);
  color: var(--gold);
  font-size: 21rpx;
  font-weight: 600;
}

.profile-bio {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-word;
}

.profile-stats {
  display: flex;
  margin-top: 26rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.62);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.62);
}

.stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.stat-static {
  opacity: 1;
}

.stat-value {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.social-error {
  margin-top: 14rpx;
}

.follow-button {
  margin-top: 22rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.follow-button.is-following {
  border: 1rpx solid var(--glass-line);
  background: var(--glass-soft);
  color: var(--ink-soft);
}

.follow-button.is-disabled {
  opacity: 0.55;
}

.self-note {
  margin-top: 18rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.segmented {
  display: flex;
  margin-top: 20rpx;
  padding: 8rpx;
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  background: var(--glass);
  box-shadow: var(--glass-inset);
  backdrop-filter: blur(18px) saturate(160%);
}

.segment {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 999rpx;
  color: var(--ink-muted);
  font-size: 26rpx;
  text-align: center;
}

.segment.active {
  background: linear-gradient(135deg, rgba(55, 169, 255, 0.94), rgba(10, 132, 255, 0.94));
  box-shadow: 0 10rpx 24rpx rgba(10, 132, 255, 0.24);
  color: #ffffff;
  font-weight: 600;
}

.list-hint {
  margin: 16rpx 6rpx 0;
}

.list-meta {
  margin: 20rpx 0 0;
  color: var(--ink-muted);
  font-size: 23rpx;
  text-align: center;
}

.content-card {
  margin-top: 18rpx;
}

.content-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.content-card-title {
  flex: 1;
  overflow: hidden;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-card-title.title-closed {
  color: var(--ink-muted);
  text-decoration: line-through;
}

.content-score {
  margin-left: 18rpx;
  color: var(--gold);
  font-size: 34rpx;
  font-weight: 700;
}

.content-card-meta {
  margin-top: 8rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.content-card-body {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.content-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.62);
}

.content-badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.badge {
  margin-right: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.badge-good {
  background: rgba(31, 157, 97, 0.14);
  color: var(--mint);
}

.badge-plain {
  background: rgba(255, 255, 255, 0.52);
  color: var(--ink-muted);
}

.content-link {
  color: var(--accent-deep);
  font-size: 23rpx;
}

.favorite-card {
  padding-top: 26rpx;
  padding-bottom: 22rpx;
}

.favorite-row {
  display: flex;
  align-items: center;
}

.favorite-copy {
  flex: 1;
  min-width: 0;
}

.favorite-card .content-card-foot {
  margin-top: 12rpx;
}

.load-more {
  margin-top: 20rpx;
  padding: 20rpx 0;
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  background: var(--glass-soft);
  color: var(--accent-deep);
  font-size: 24rpx;
  text-align: center;
}
