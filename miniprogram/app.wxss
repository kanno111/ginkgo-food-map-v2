/**
 * 全局 Liquid Glass 视觉基线。
 *
 * 思路是把高饱和的环境色放在页面底层，再让半透明、带高光和细边框的玻璃面板浮在其上：
 * 玻璃本身不做不透明填充，背景的蓝、青、暖黄才能透出来，形成流动的层次。
 * 微信基础库对 backdrop-filter 的支持不一致，因此同时保留 rgba 背景和内阴影作为降级。
 */
page {
  --ink: #08192b;
  --ink-soft: #3f5366;
  --ink-muted: #6f8294;
  --accent: #0a84ff;
  --accent-deep: #0066cc;
  --mint: #1f9d61;
  --gold: #c6860b;
  --danger: #b83a34;
  --glass: rgba(255, 255, 255, 0.56);
  --glass-strong: rgba(255, 255, 255, 0.76);
  --glass-soft: rgba(255, 255, 255, 0.34);
  --glass-line: rgba(255, 255, 255, 0.78);
  --glass-shadow: 0 22rpx 64rpx rgba(27, 63, 104, 0.14);
  --glass-inset: inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  background: linear-gradient(160deg, #e6f3ff 0%, #eef8f1 44%, #fff5e2 100%);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 环境光只负责提供可被玻璃折射的颜色，不接收点击。 */
.ambient {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
  /* page 自身形成层叠上下文，负层级让环境光位于页面背景之上、正文之下。 */
  z-index: -1;
}

.ambient-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(40px);
  opacity: 0.55;
}

.ambient-a {
  width: 520rpx;
  height: 520rpx;
  top: -150rpx;
  right: -120rpx;
  background: radial-gradient(circle, #58b8ff 0%, rgba(88, 184, 255, 0) 68%);
}

.ambient-b {
  width: 560rpx;
  height: 560rpx;
  top: 32%;
  left: -240rpx;
  background: radial-gradient(circle, #5fe0bd 0%, rgba(95, 224, 189, 0) 70%);
}

.ambient-c {
  width: 480rpx;
  height: 480rpx;
  bottom: -160rpx;
  right: -100rpx;
  background: radial-gradient(circle, #ffd36b 0%, rgba(255, 211, 107, 0) 70%);
}

.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.tab-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--glass);
  border: 1rpx solid var(--glass-line);
  border-radius: 36rpx;
  padding: 30rpx;
  box-shadow: var(--glass-shadow), var(--glass-inset);
  backdrop-filter: blur(18px) saturate(160%);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
}

.glass-soft {
  background: var(--glass-soft);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.muted {
  color: var(--ink-muted);
}

.strong {
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 42rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  background: linear-gradient(135deg, #37a9ff 0%, #0a84ff 52%, #0066cc 100%);
  box-shadow: 0 16rpx 36rpx rgba(10, 132, 255, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-button[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 32rpx;
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  background: var(--glass-soft);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  color: var(--ink-soft);
  font-size: 27rpx;
  font-weight: 600;
  backdrop-filter: blur(10px) saturate(140%);
  -webkit-backdrop-filter: blur(10px) saturate(140%);
}

.error-text {
  color: var(--danger);
  font-size: 25rpx;
  line-height: 1.6;
}

.empty-state {
  padding: 80rpx 32rpx;
  color: var(--ink-muted);
  text-align: center;
}

.divider {
  height: 1rpx;
  background: rgba(8, 25, 43, 0.08);
}

.tag {
  display: inline-block;
  margin: 0 12rpx 12rpx 0;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 999rpx;
  background: var(--glass-soft);
  color: var(--ink-soft);
  font-size: 23rpx;
}

.field-shell {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.42);
  box-shadow: inset 0 2rpx 8rpx rgba(27, 63, 104, 0.06);
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.field-placeholder {
  color: #91a3b4;
}

.card-press {
  opacity: 0.82;
  transform: scale(0.985);
}
